# Copy to .env for local work, or set these in the Vercel project settings.
# Origin of the site, no trailing slash. Used for canonical URLs, the sitemap, RSS and Umami.
PUBLIC_SITE_URL=https://simonkana.vercel.app

# Umami Cloud. Leave empty to render no analytics script (local dev and previews stay untracked).
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
PUBLIC_UMAMI_WEBSITE_ID=a219572b-c05b-47f6-92b9-f32d03269c14

---
import { SITE, host } from '../lib/site';
const year = new Date().getFullYear();
const domain = host(Astro.site);
---
<footer class="site-footer wrap">
  <hr class="rule" />
  <div class="row mono">
    <p class="curl"><span class="muted" aria-hidden="true">$</span> <a href="/now.txt">curl {domain}/now</a></p>
    <ul>
      <li><a href={SITE.links.github} rel="me">GitHub ↗</a></li>
      <li><a href={SITE.links.youtube} rel="me">YouTube ↗</a></li>
      <li><a href="/feed.xml">RSS ↗</a></li>
      <li><a href="/privacy/">Privacy</a></li>
      <li>
        <button type="button" class="theme" data-theme-toggle aria-label="Switch to dark mode">
          <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M8 1.5a6.5 6.5 0 0 0 0 13z" fill="currentColor" /></svg>
          <span data-theme-label>dark</span>
        </button>
      </li>
      <li class="muted">Prague · {year}</li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { padding-bottom: clamp(24px, 4vw, 40px); }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; padding-top: 20px; color: var(--muted); }
  p { margin: 0; }
  ul { display: flex; flex-wrap: wrap; gap: 6px 16px; list-style: none; margin: 0; padding: 0; }
  a { color: var(--muted); text-decoration: none; }
  a:hover { color: var(--ink); }
  .curl a { color: var(--ink); }
  /* Hidden without JS (it could not do anything); the head script adds .theme-js. */
  .theme { display: none; font: inherit; color: var(--muted); background: none; border: 0; padding: 0; cursor: pointer; align-items: center; gap: 6px; }
  :global(.theme-js) .theme { display: inline-flex; }
  .theme:hover { color: var(--ink); }
  .theme svg { flex: none; }
</style>

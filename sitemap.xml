<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.pages %}{% unless page.name == "404.html" or page.name == "robots.txt" or page.name == "sitemap.xml" or page.sitemap == false %}
  <url><loc>{{ page.url | absolute_url | xml_escape }}</loc></url>
  {% endunless %}{% endfor %}
  {% for post in site.posts %}
  <url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
  {% for project in site.work %}
  <url><loc>{{ project.url | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
</urlset>
